{
  "name": "irisin-webui",
  "private": true,
  "description": "The page that manages Irisin from a browser on the local network (Documentation/WebManagement.md). `pnpm build` writes dist/, which the app's Build Web UI phase copies into irisin.app/WebUI.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "sync": "node scripts/sync-assets.js",
    "build": "node scripts/sync-assets.js && webpack --mode production",
    "watch": "node scripts/sync-assets.js && webpack --mode development --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "6.0.1"
  }
}
