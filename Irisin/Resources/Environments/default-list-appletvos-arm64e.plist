<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The repositories onboarding recommends on Apple TV (RootHide,
  appletvos-arm64e): those that publish appletvos-arm64e packages, OwnGoal
  Stripe's bootstrap packages (its one suite, 1900, built for tvOS 16 and
  later) and OwnGoal's own.
-->
<plist version="1.0">
<array>
	<dict>
		<key>source</key>
		<string>deb https://stripe.owngoal.dev 1900 main</string>
	</dict>
	<dict>
		<key>source</key>
		<string>https://apt.owngoal.dev</string>
	</dict>
</array>
</plist>
