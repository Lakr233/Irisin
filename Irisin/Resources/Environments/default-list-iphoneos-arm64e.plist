<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The repositories onboarding recommends on roothide: those that publish
  iphoneos-arm64e packages. Havoc, Chariz and BigBoss publish rootless
  packages only, which nothing here installs; there is no ElleKit, since
  roothide brings its own injector.
-->
<plist version="1.0">
<array>
	<dict>
		<key>source</key>
		<string>https://roothide.github.io</string>
	</dict>
	<!--
	  roothide's own Procursus build: 1800 is iOS 15, and iOS 16 and later
	  use 1900.
	-->
	<dict>
		<key>source</key>
		<string>deb https://roothide.github.io/procursus iphoneos-arm64e/1800 main</string>
		<key>maximumSystemVersion</key>
		<integer>15</integer>
	</dict>
	<dict>
		<key>source</key>
		<string>deb https://roothide.github.io/procursus iphoneos-arm64e/1900 main</string>
		<key>minimumSystemVersion</key>
		<integer>16</integer>
	</dict>
	<dict>
		<key>source</key>
		<string>https://apt.owngoal.dev</string>
	</dict>
</array>
</plist>
