    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Irisin بصمة الوجه للتحقق من أنك مالك هذا الجهاز قبل تغيير الحزم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাকেজ পরিবর্তন করার আগে এই ডিভাইসটি আপনার কিনা তা যাচাই করতে Irisin Face ID ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin verwendet Face ID, um zu überprüfen, ob dir dieses Gerät gehört, bevor Pakete geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin uses Face ID to verify that you own this device before it changes packages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin usa Face ID para verificar que eres el propietario de este dispositivo antes de cambiar paquetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin utilise Face ID pour vérifier que cet appareil vous appartient avant de modifier des paquets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैकेज बदलने से पहले यह सत्यापित करने के लिए कि यह डिवाइस आपका है, Irisin Face ID का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin menggunakan Face ID untuk memverifikasi bahwa Anda pemilik perangkat ini sebelum mengubah paket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin usa Face ID per verificare che sei il proprietario di questo dispositivo prima di modificare i pacchetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisinは、パッケージを変更する前にFace IDを使用してこのデバイスの所有者であることを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin은 패키지를 변경하기 전에 Face ID를 사용하여 사용자가 이 기기의 소유자인지 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Irisin usa o Face ID para verificar se você é o dono deste dispositivo antes de alterar pacotes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin использует Face ID, чтобы перед изменением пакетов проверить, что Вы владелец этого устройства."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin hutumia Face ID kuthibitisha kwamba unamiliki kifaa hiki kabla ya kubadilisha vifurushi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin, paketleri değiştirmeden önce bu aygıtın sahibi olduğunuzu doğrulamak için Face ID'yi kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin sử dụng Face ID để xác minh rằng bạn sở hữu thiết bị này trước khi thay đổi gói."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin ń lo Face ID láti ṣàrídájú pé ìwọ ni o ni ẹ̀rọ yìí kí ó tó yí àwọn pákéèjì padà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin 在更改软件包之前使用面容 ID 验证设备所有权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin 會在變更套件之前使用 Face ID 驗證你是否為此裝置的擁有者。"
          }
        }
      }
    }
  },
  "version" : "1.3"
}
