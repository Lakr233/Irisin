    "%@ %@: the repository sent unreadable package information. Refresh the repository and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: أرسل المستودع معلومات حزمة تتعذر قراءتها. حدّث المستودع وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: রিপোজিটরি থেকে পাঠানো প্যাকেজের তথ্য পড়া যায়নি। রিপোজিটরি রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: Die Quelle hat unlesbare Paketinformationen gesendet. Aktualisiere die Quelle und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: the repository sent unreadable package information. Refresh the repository and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: el repositorio envió información del paquete que no se puede leer. Actualiza el repositorio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ : le dépôt a fourni des informations de paquet illisibles. Actualisez le dépôt et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: रिपॉज़िटरी ने ऐसी पैकेज जानकारी भेजी जिसे पढ़ा नहीं जा सका। रिपॉज़िटरी रीफ़्रेश करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: repositori mengirim informasi paket yang tidak dapat dibaca. Segarkan repositori, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: le informazioni sul pacchetto inviate dal repository non sono leggibili. Aggiorna il repository e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：リポジトリから読み取れないパッケージ情報が送られました。リポジトリを更新して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: 소스에서 받은 패키지 정보를 읽을 수 없습니다. 소스를 새로 고친 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: o repositório enviou informações de pacote ilegíveis. Atualize o repositório e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: репозиторий передал нечитаемые сведения о пакете. Обновите репозиторий и повторите попытку."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: hazina ilituma maelezo ya kifurushi yasiyosomeka. Onyesha upya hazina kisha ujaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: Depo okunamayan paket bilgisi gönderdi. Depoyu yenileyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: nguồn đã gửi thông tin gói không đọc được. Hãy làm mới nguồn rồi thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: ibi ìpamọ́ náà fi ìwífún pákéèjì tí kò ṣeé kà ránṣẹ́. Sọ ibi ìpamọ́ náà dọ̀tun kí o sì gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：软件源提供的软件包信息无法读取。请刷新软件源后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：軟體源提供的套件資訊無法讀取。請重新整理軟體源後再試一次。"
          }
        }
      }
    },
    "%@ cannot be installed in compatibility mode, which does not convert %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تثبيت %1$@ في وضع التوافق، الذي لا يحوّل %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ সামঞ্জস্য মোডে ইনস্টল করা যাবে না, কারণ এই মোড %2$@ রূপান্তর করে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann nicht im Kompatibilitätsmodus installiert werden, der %2$@ nicht umwandelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cannot be installed in compatibility mode, which does not convert %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no se puede instalar en el modo de compatibilidad, que no convierte %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas être installé en mode de compatibilité, qui ne convertit pas %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ को अनुकूलता मोड में इंस्टॉल नहीं किया जा सकता, क्योंकि यह मोड %2$@ को रूपांतरित नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tidak dapat diinstal dalam mode kompatibilitas, yang tidak mengonversi %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non può essere installato in modalità compatibilità, che non converte %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は互換モードでインストールできません。互換モードは %2$@ を変換しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 패키지는 호환 모드로 설치할 수 없습니다. 호환 모드는 %2$@을(를) 변환하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não pode ser instalado no modo de compatibilidade, que não converte %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ нельзя установить в режиме совместимости: он не преобразует %2$@."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ haiwezi kusakinishwa katika hali ya uoanifu, ambayo haibadilishi %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uyumluluk modunda yüklenemez; uyumluluk modu %2$@ için dönüştürme yapmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cài đặt %1$@ ở chế độ tương thích, vốn không chuyển đổi %2$@."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kò lè fi %1$@ sórí ẹ̀rọ ní ìpò ìbáramu, nítorí pé ìpò ìbáramu kì í yí %2$@ padà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法以兼容模式安装：兼容模式不转换 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 無法以相容模式安裝：相容模式不轉換 %2$@。"
          }
        }
      }
    },
