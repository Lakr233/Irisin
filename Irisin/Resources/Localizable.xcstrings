            "value" : "Yükleme hazırlanırken paketler değişti. Yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói đã thay đổi trong lúc chuẩn bị cài đặt. Hãy thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn pákéèjì yí padà nígbà tí a ń múra ìfisórí ẹ̀rọ sílẹ̀. Gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备安装时软件包发生了变化。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備安裝時套件已有變動。請再試一次。"
          }
        }
      }
    },
    "Packages changed. Review the changes and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت الحزم. راجِع التغييرات وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাকেজ পরিবর্তিত হয়েছে। পরিবর্তনগুলি দেখে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
