        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্যাকেজগুলি বৈধ ক্রমে ইনস্টল করা যায়নি: %@। এগুলির কয়েকটি সারি থেকে সরিয়ে আবার চেষ্টা করুন।"
