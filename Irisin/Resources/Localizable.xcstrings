    "The package is half-installed. Install it again to repair it, or remove it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزمة مثبّتة جزئيًا. ثبّتها مرة أخرى لإصلاحها، أو أزِلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাকেজটি অর্ধেক ইনস্টল হয়েছে। মেরামত করতে এটি আবার ইনস্টল করুন, অথবা এটি সরান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
