    "The home screen restarts and every open app closes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُعاد تشغيل الشاشة الرئيسية وستُغلق جميع التطبيقات المفتوحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হোম স্ক্রিন পুনরায় চালু হবে এবং খোলা থাকা সব অ্যাপ বন্ধ হয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
