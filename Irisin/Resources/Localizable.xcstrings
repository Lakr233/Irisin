    "Review the queue before you execute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع قائمة الانتظار قبل التنفيذ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালানোর আগে সারিটি পর্যালোচনা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Warteschlange vor dem Ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the queue before you execute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la cola antes de ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la file d’attente avant d’exécuter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलाने से पहले कतार की समीक्षा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa antrean sebelum Anda menjalankannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la coda prima di eseguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行する前にキューを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행하기 전에 대기열을 검토하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise a fila antes de executar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте очередь перед выполнением."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kagua foleni kabla ya kutekeleza."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürütmeden önce kuyruğu gözden geçirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy xem lại hàng đợi trước khi thực hiện."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣàyẹ̀wò ìtòsẹ́ kí o tó mú un ṣẹ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在执行前检查队列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在執行前檢查佇列。"
          }
        }
      }
    },
    "Packages in compatibility mode are patched before they install. If patching changes the queue, review it again before you execute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُصحَّح الحزم في وضع التوافق قبل تثبيتها. إذا غيّر التصحيح قائمة الانتظار، فراجعها مرة أخرى قبل التنفيذ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সামঞ্জস্য মোডের প্যাকেজগুলি ইনস্টল হওয়ার আগে প্যাচ করা হয়। প্যাচ করার ফলে সারি পরিবর্তিত হলে, চালানোর আগে এটি আবার পর্যালোচনা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakete im Kompatibilitätsmodus werden vor der Installation gepatcht. Wenn das Patchen die Warteschlange ändert, prüfe sie vor dem Ausführen erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages in compatibility mode are patched before they install. If patching changes the queue, review it again before you execute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes en modo de compatibilidad se parchean antes de instalarse. Si el parche cambia la cola, revísala de nuevo antes de ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paquets en mode de compatibilité sont patchés avant leur installation. Si le patch modifie la file d’attente, vérifiez-la à nouveau avant d’exécuter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुकूलता मोड के पैकेज इंस्टॉल होने से पहले पैच किए जाते हैं। यदि पैच करने से कतार बदल जाए, तो चलाने से पहले उसकी फिर से समीक्षा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket dalam mode kompatibilitas di-patch sebelum diinstal. Jika patch mengubah antrean, periksa kembali sebelum Anda menjalankannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti in modalità compatibilità ricevono la patch prima dell’installazione. Se la patch modifica la coda, controllala di nuovo prima di eseguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換モードのパッケージは、インストール前にパッチが適用されます。パッチによってキューが変わった場合は、実行する前にもう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환 모드의 패키지는 설치 전에 패치됩니다. 패치로 대기열이 변경되면 실행하기 전에 다시 검토하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes em modo de compatibilidade recebem o patch antes da instalação. Se o patch mudar a fila, revise-a novamente antes de executar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты в режиме совместимости патчатся перед установкой. Если патч изменит очередь, проверьте её ещё раз перед выполнением."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifurushi vilivyo katika hali ya uoanifu huwekewa viraka kabla ya kusakinishwa. Ikiwa kuweka viraka kutabadilisha foleni, ikague tena kabla ya kutekeleza."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumluluk modundaki paketler yüklenmeden önce yamalanır. Yamalama kuyruğu değiştirirse yürütmeden önce kuyruğu yeniden gözden geçirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói ở chế độ tương thích được vá trước khi cài đặt. Nếu việc vá làm thay đổi hàng đợi, hãy xem lại trước khi thực hiện."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A máa ń ṣe àtúnṣe àwọn pákéèjì tí ó wà ní ìpò ìbáramu kí a tó fi wọ́n sórí ẹ̀rọ. Tí àtúnṣe bá yí ìtòsẹ́ padà, ṣàyẹ̀wò rẹ̀ lẹ́ẹ̀kansí kí o tó mú un ṣẹ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兼容模式下的软件包会在安装前进行修补。如果修补更改了队列，请在执行前再次检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相容模式下的套件會在安裝前進行修補。如果修補變更了佇列，請在執行前再次檢查。"
          }
        }
      }
    },
    "You selected version %@, built for %@, which would be installed in compatibility mode. %@ offers version %@ built for this system." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد اخترت الإصدار %1$@ المبني لـ %2$@، وسيتم تثبيته في وضع التوافق. يوفّر %3$@ الإصدار %4$@ المبني لهذا النظام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি %2$@-এর জন্য তৈরি সংস্করণ %1$@ নির্বাচন করেছেন, যা সামঞ্জস্য মোডে ইনস্টল হবে। %3$@ এই সিস্টেমের জন্য তৈরি সংস্করণ %4$@ দিচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Version %1$@ gewählt, die für %2$@ erstellt wurde und im Kompatibilitätsmodus installiert würde. %3$@ bietet Version %4$@ an, die für dieses System erstellt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You selected version %1$@, built for %2$@, which would be installed in compatibility mode. %3$@ offers version %4$@ built for this system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has seleccionado la versión %1$@, compilada para %2$@, que se instalaría en modo de compatibilidad. %3$@ ofrece la versión %4$@ compilada para este sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez choisi la version %1$@, conçue pour %2$@, qui serait installée en mode de compatibilité. %3$@ propose la version %4$@ conçue pour ce système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने वर्ज़न %1$@ चुना है, जो %2$@ के लिए बनाया गया है और अनुकूलता मोड में इंस्टॉल होगा। %3$@ इस सिस्टम के लिए बनाया गया वर्ज़न %4$@ उपलब्ध कराता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memilih versi %1$@, yang dibuat untuk %2$@ dan akan diinstal dalam mode kompatibilitas. %3$@ menawarkan versi %4$@ yang dibuat untuk sistem ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato la versione %1$@, compilata per %2$@, che verrebbe installata in modalità compatibilità. %3$@ offre la versione %4$@ compilata per questo sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したバージョン %1$@ は %2$@ 向けにビルドされており、互換モードでインストールされます。%3$@ には、このシステム向けにビルドされたバージョン %4$@ があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 버전 %1$@은(는) %2$@용으로 빌드되어 호환 모드로 설치됩니다. %3$@에서 이 시스템용으로 빌드된 버전 %4$@을(를) 제공합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você selecionou a versão %1$@, compilada para %2$@, que seria instalada em modo de compatibilidade. %3$@ oferece a versão %4$@ compilada para este sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выбрали версию %1$@, собранную для %2$@; она будет установлена в режиме совместимости. %3$@ предлагает версию %4$@, собранную для этой системы."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umechagua toleo %1$@, lililojengwa kwa ajili ya %2$@, ambalo lingesakinishwa katika hali ya uoanifu. %3$@ inatoa toleo %4$@ lililojengwa kwa ajili ya mfumo huu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ için oluşturulmuş %1$@ sürümünü seçtiniz; bu sürüm uyumluluk modunda yüklenir. %3$@, bu sistem için oluşturulmuş %4$@ sürümünü sunuyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã chọn phiên bản %1$@, được dựng cho %2$@, và nó sẽ được cài đặt ở chế độ tương thích. %3$@ cung cấp phiên bản %4$@ được dựng cho hệ thống này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O yan ẹ̀yà %1$@, tí a kọ́ fún %2$@, èyí tí a ó fi sórí ẹ̀rọ ní ìpò ìbáramu. %3$@ ń pèsè ẹ̀yà %4$@ tí a kọ́ fún sísítẹ́mù yìí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选择了版本 %1$@，它为 %2$@ 构建，将以兼容模式安装。%3$@ 提供为当前系统构建的版本 %4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你選擇了版本 %1$@，它為 %2$@ 建置，將以相容模式安裝。%3$@ 提供為目前系統建置的版本 %4$@。"
          }
        }
      }
    },
    "You selected version %@. %@ offers version %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد اخترت الإصدار %1$@. يوفّر %2$@ الإصدار %3$@."
