    "Queue several tweaks and install them at once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف عدة إضافات إلى قائمة الانتظار وثبّتها دفعة واحدة."
