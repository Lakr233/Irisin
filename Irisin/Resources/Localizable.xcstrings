    "Packages changed while checking dependencies. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت الحزم أثناء فحص التبعيات. حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্ভরতা পরীক্ষা করার সময় প্যাকেজ পরিবর্তিত হয়েছে। আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Abhängigkeitsprüfung haben sich Pakete geändert. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages changed while checking dependencies. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes cambiaron mientras se comprobaban las dependencias. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paquets ont changé pendant la vérification des dépendances. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्भरताएँ जाँचते समय पैकेज बदल गए। फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket berubah saat memeriksa dependensi. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti sono cambiati durante il controllo delle dipendenze. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依存関係の確認中にパッケージが変更されました。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의존성을 확인하는 동안 패키지가 변경되었습니다. 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pacotes mudaram durante a verificação das dependências. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты изменились во время проверки зависимостей. Повторите попытку."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifurushi vilibadilika wakati wa kukagua utegemezi. Jaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağımlılıklar denetlenirken paketler değişti. Yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói đã thay đổi trong lúc kiểm tra phụ thuộc. Hãy thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn pákéèjì yí padà nígbà tí a ń ṣàyẹ̀wò àwọn ìgbáralé. Gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查依赖时软件包发生了变化。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查相依性時套件已有變動。請再試一次。"
          }
        }
      }
    },
