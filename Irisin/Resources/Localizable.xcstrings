    "Review the script output. If the package does not work, remove it or install a fixed version." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع مخرجات النص البرمجي. إذا لم تعمل الحزمة، فأزلها أو ثبّت إصدارًا مصححًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিপ্টের আউটপুট পর্যালোচনা করুন। প্যাকেজটি কাজ না করলে, এটি সরান অথবা একটি সংশোধিত সংস্করণ ইনস্টল করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen Sie die Skriptausgabe. Falls das Paket nicht funktioniert, entfernen Sie es oder installieren Sie eine korrigierte Version."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the script output. If the package does not work, remove it or install a fixed version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise la salida del script. Si el paquete no funciona, elimínelo o instale una versión corregida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez la sortie du script. Si le paquet ne fonctionne pas, supprimez-le ou installez une version corrigée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रिप्ट आउटपुट की समीक्षा करें। यदि पैकेज काम न करे, तो उसे हटा दें या कोई ठीक किया गया वर्ज़न इंस्टॉल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa keluaran skrip. Jika paket tidak berfungsi, buang paket tersebut atau instal versi yang telah diperbaiki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l’output dello script. Se il pacchetto non funziona, rimuovilo o installa una versione corretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトの出力を確認してください。パッケージが動作しない場合は、削除するか修正版をインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트 출력을 확인하세요. 패키지가 작동하지 않으면 제거하거나 수정된 버전을 설치하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise a saída do script. Se o pacote não funcionar, remova-o ou instale uma versão corrigida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте вывод сценария. Если пакет не работает, удалите его или установите исправленную версию."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kagua matokeo ya hati. Ikiwa kifurushi hakifanyi kazi, kiondoe au usakinishe toleo lililorekebishwa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betik çıktısını gözden geçirin. Paket çalışmıyorsa paketi kaldırın ya da düzeltilmiş bir sürümünü yükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy xem lại đầu ra của tập lệnh. Nếu gói không hoạt động, hãy gỡ gói hoặc cài đặt phiên bản đã được sửa lỗi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣàyẹ̀wò àbájáde síkírípítì náà. Tí pákéèjì náà kò bá ṣiṣẹ́, yọ ọ́ kúrò tàbí fi ẹ̀yà tí a ti tún ṣe sórí ẹ̀rọ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查脚本输出。如果软件包无法正常工作，请将其移除或安装修复后的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查指令碼輸出。如果套件無法運作，請將其移除或安裝已修正的版本。"
          }
        }
      }
    },
    "The %@ script of %@ failed, but installation continued." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
