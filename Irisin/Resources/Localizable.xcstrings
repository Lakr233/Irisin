          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói này vẫn ở trạng thái đã cài đặt. Hãy quay lại và chọn “Thử lại”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此软件包仍处于已安装状态。请返回并选择“再试一次”。"
