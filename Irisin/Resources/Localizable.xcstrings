        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم العثور على حزم مطابقة، لكن متطلباتها متعارضة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিলে যাওয়া প্যাকেজ পাওয়া গেছে, কিন্তু তাদের প্রয়োজনীয়তা পরস্পরবিরোধী।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurden passende Pakete gefunden, aber ihre Anforderungen widersprechen sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matching packages were found, but their requirements conflict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontraron paquetes coincidentes, pero sus requisitos entran en conflicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des paquets correspondants ont été trouvés, mais leurs exigences sont en conflit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेल खाते पैकेज मिले, लेकिन उनकी आवश्यकताएँ आपस में टकराती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket yang cocok ditemukan, tetapi persyaratannya saling berkonflik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati trovati pacchetti corrispondenti, ma i loro requisiti sono in conflitto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するパッケージは見つかりましたが、要件が競合しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 패키지를 찾았지만 요구 사항이 서로 충돌합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram encontrados pacotes correspondentes, mas os requisitos deles entram em conflito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подходящие пакеты найдены, но их требования конфликтуют."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifurushi vinavyolingana vimepatikana, lakini mahitaji yake yanagongana."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşen paketler bulundu ancak gereksinimleri çakışıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tìm thấy các gói phù hợp nhưng yêu cầu của chúng xung đột nhau."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rí àwọn pákéèjì tí ó bá mu, ṣùgbọ́n àwọn ohun tí wọ́n nílò ń forígbárí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到匹配的软件包，但它们的要求相互冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到符合的套件，但其需求互相衝突。"
          }
        }
      }
    },
