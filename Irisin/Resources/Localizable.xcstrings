        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件已有變動。請檢查變更後再試一次。"
          }
        }
      }
    },
    "Packages from deleted repositories will no longer be listed. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تظهر حزم المستودعات المحذوفة بعد الآن. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছে ফেলা রিপোজিটরির প্যাকেজগুলি আর তালিকায় দেখানো হবে না। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakete aus gelöschten Quellen werden nicht mehr angezeigt. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages from deleted repositories will no longer be listed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes de los repositorios eliminados dejarán de mostrarse. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paquets des dépôts supprimés ne seront plus affichés. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीट की गई रिपॉज़िटरी के पैकेज अब सूची में नहीं दिखेंगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket dari repositori yang dihapus tidak akan ditampilkan lagi. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti dei repository eliminati non verranno più elencati. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したリポジトリのパッケージは表示されなくなります。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 소스의 패키지가 더 이상 목록에 표시되지 않습니다. 이 동작은 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pacotes dos repositórios apagados não serão mais listados. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты из удаленных репозиториев больше не будут отображаться. Это действие нельзя отменить."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifurushi kutoka hazina zilizofutwa havitaorodheshwa tena. Kitendo hiki hakiwezi kutenduliwa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen depolardaki paketler artık listelenmeyecek. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói từ các nguồn đã xóa sẽ không còn được liệt kê. Không thể hoàn tác thao tác này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kò ní tò àwọn pákéèjì láti inú àwọn ibi ìpamọ́ tí a paarẹ́ mọ́. A kò lè dá èyí padà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除软件源中的软件包将不再列出。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除軟體源中的套件將不再列出。此動作無法復原。"
          }
        }
      }
    },
