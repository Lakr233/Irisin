    "You added these repositories before. Swipe one to forget it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفت هذه المستودعات من قبل. اسحب أحدها لنسيانه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই রিপোজিটরিগুলি আপনি আগে যোগ করেছিলেন। ভুলে যেতে একটিতে সোয়াইপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quellen hast du früher hinzugefügt. Wische über eine Quelle, um sie zu vergessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You added these repositories before. Swipe one to forget it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya añadiste estos repositorios antes. Desliza uno para olvidarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà ajouté ces dépôts. Balayez-en un pour l’oublier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने ये रिपॉज़िटरी पहले जोड़ी थीं। किसी एक को भुलाने के लिए उस पर स्वाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda pernah menambahkan repositori ini sebelumnya. Geser salah satu untuk melupakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai aggiunto questi repository in precedenza. Scorri su uno per dimenticarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に追加したリポジトリです。スワイプすると履歴から削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 추가한 소스입니다. 기록에서 지우려면 항목을 쓸어넘기십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já adicionou estes repositórios antes. Deslize um deles para esquecê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти репозитории вы добавляли раньше. Смахните репозиторий, чтобы забыть его."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uliongeza hazina hizi awali. Telezesha kidole kwenye moja ili kuisahau."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu depoları daha önce eklediniz. Birini unutmak için kaydırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã từng thêm các nguồn này. Vuốt một nguồn để quên nguồn đó."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ti ṣàfikún àwọn ibi ìpamọ́ wọ̀nyí tẹ́lẹ̀. Fa ọ̀kan kọjá láti gbàgbé rẹ̀."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是你之前添加过的软件源。左滑可以删除记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是你先前加入過的軟體源。滑動項目即可移除。"
          }
        }
      }
    },
    "You are about to install software in compatibility mode (%@). These packages are converted automatically during installation to a format this system supports. This may cause problems and damage the system." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت على وشك تثبيت برامج في وضع التوافق (%@). تُحوَّل هذه الحزم تلقائيًا أثناء التثبيت إلى تنسيق يدعمه هذا النظام. قد يسبب ذلك مشكلات ويُلحق الضرر بالنظام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি সামঞ্জস্য মোডে (%@) সফটওয়্যার ইনস্টল করতে চলেছেন। এই প্যাকেজগুলি ইনস্টলেশনের সময় স্বয়ংক্রিয়ভাবে এই সিস্টেম সমর্থন করে এমন ফরম্যাটে রূপান্তরিত হয়। এতে সমস্যা হতে পারে এবং সিস্টেমের ক্ষতি হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du installierst gleich Software im Kompatibilitätsmodus (%@). Diese Pakete werden bei der Installation automatisch in ein Format umgewandelt, das dieses System unterstützt. Das kann Probleme verursachen und das System beschädigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are about to install software in compatibility mode (%@). These packages are converted automatically during installation to a format this system supports. This may cause problems and damage the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas a instalar software en el modo de compatibilidad (%@). Estos paquetes se convierten automáticamente durante la instalación a un formato compatible con este sistema. Esto puede causar problemas y dañar el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous allez installer des logiciels en mode de compatibilité (%@). Ces paquets sont convertis automatiquement pendant l’installation dans un format pris en charge par ce système. Cela peut causer des problèmes et endommager le système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अनुकूलता मोड (%@) में सॉफ़्टवेयर इंस्टॉल करने वाले हैं। ये पैकेज इंस्टॉलेशन के दौरान अपने आप इस सिस्टम द्वारा समर्थित फ़ॉर्मैट में बदल दिए जाते हैं। इससे समस्याएँ हो सकती हैं और सिस्टम को नुकसान पहुँच सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan menginstal perangkat lunak dalam mode kompatibilitas (%@). Paket ini dikonversi secara otomatis saat instalasi ke format yang didukung sistem ini. Hal ini dapat menimbulkan masalah dan merusak sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per installare software in modalità compatibilità (%@). Questi pacchetti vengono convertiti automaticamente durante l’installazione in un formato supportato da questo sistema. Ciò potrebbe causare problemi e danneggiare il sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換モードのソフトウェア（%@）をインストールしようとしています。これらのパッケージはインストール時に、このシステムが対応する形式へ自動的に変換されます。問題が起きたり、システムが破損したりするおそれがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환 모드 소프트웨어(%@)를 설치하려고 합니다. 이 패키지들은 설치 중에 이 시스템이 지원하는 형식으로 자동 변환됩니다. 이로 인해 문제가 생기고 시스템이 손상될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está prestes a instalar software no modo de compatibilidade (%@). Esses pacotes são convertidos automaticamente durante a instalação para um formato compatível com este sistema. Isso pode causar problemas e danificar o sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы собираетесь установить программы в режиме совместимости (%@). При установке эти пакеты автоматически преобразуются в формат, который поддерживает эта система. Это может вызвать проблемы и повредить систему."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unakaribia kusakinisha programu katika hali ya uoanifu (%@). Vifurushi hivi hubadilishwa kiotomatiki wakati wa usakinishaji kuwa umbizo linalotumika na mfumo huu. Hii inaweza kusababisha matatizo na kuharibu mfumo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumluluk modunda yazılım yüklemek üzeresiniz (%@). Bu paketler yükleme sırasında bu sistemin desteklediği bir biçime otomatik olarak dönüştürülür. Bu, sorunlara yol açabilir ve sisteme zarar verebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sắp cài đặt phần mềm ở chế độ tương thích (%@). Trong khi cài đặt, các gói này sẽ được tự động chuyển đổi sang định dạng mà hệ thống này hỗ trợ. Điều này có thể gây ra sự cố và làm hỏng hệ thống."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fẹ́ fi sọ́fítíwè sórí ẹ̀rọ ní ìpò ìbáramu (%@). A máa yí àwọn pákéèjì wọ̀nyí padà láìfọwọ́ṣe nígbà ìfisórí ẹ̀rọ sí ọ̀nà tí sísítẹ́mù yìí ṣe àtìlẹ́yìn fún. Èyí lè fa ìṣòro kí ó sì ba sísítẹ́mù jẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将要安装兼容模式的软件（%@）。这些软件在安装时会被自动转换成当前系统支持的格式。这可能出现问题，并导致系统损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你即將安裝相容模式的軟體（%@）。這些軟體在安裝時會自動轉換成目前系統支援的格式。這可能會出現問題，並導致系統損壞。"
          }
        }
      }
    },
