            "value" : "其中的软件包将不再列出。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中的套件將不再列出。此動作無法復原。"
          }
        }
      }
    },
