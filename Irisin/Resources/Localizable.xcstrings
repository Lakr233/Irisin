    "%@: kept at the current version by another package or a blocked update." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: أُبقيت على الإصدار الحالي بسبب حزمة أخرى أو تحديث محظور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: অন্য একটি প্যাকেজ বা ব্লক করা আপডেটের কারণে বর্তমান সংস্করণে রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Bleibt wegen eines anderen Pakets oder eines blockierten Updates auf der aktuellen Version."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: kept at the current version by another package or a blocked update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: se mantiene en la versión actual por otro paquete o por una actualización bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : conservé à la version actuelle à cause d’un autre paquet ou d’une mise à jour bloquée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: किसी अन्य पैकेज या ब्लॉक किए गए अपडेट के कारण वर्तमान वर्ज़न पर रखा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: dipertahankan pada versi saat ini oleh paket lain atau pembaruan yang diblokir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mantenuto alla versione attuale da un altro pacchetto o da un aggiornamento ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：ほかのパッケージまたはブロックしたアップデートにより、現在のバージョンのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 다른 패키지 또는 차단된 업데이트로 인해 현재 버전이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mantido na versão atual por outro pacote ou por uma atualização bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: оставлена текущая версия из-за другого пакета или заблокированного обновления."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: imebaki katika toleo la sasa kwa sababu ya kifurushi kingine au sasisho lililozuiwa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Başka bir paket veya engellenen bir güncelleme nedeniyle geçerli sürümde tutuluyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: được giữ ở phiên bản hiện tại do một gói khác hoặc do cập nhật đã bị chặn."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: a pa á mọ́ ní ẹ̀yà tó wà lọ́wọ́ nítorí pákéèjì mìíràn tàbí ìmúdójúìwọ̀n tí a dí lọ́nà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
