          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет возвращен в прежнее состояние. Вернитесь назад и выберите «Повторить попытку»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói đã được khôi phục về trạng thái trước đó. Hãy quay lại và chọn “Thử lại”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
