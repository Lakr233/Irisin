          "stringUnit" : {
            "state" : "translated",
            "value" : "Separados por espacios. Déjalo vacío para un repositorio plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparés par des espaces. Laissez vide pour un dépôt plat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पेस से अलग करें। फ़्लैट रिपॉज़िटरी के लिए खाली छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipisahkan dengan spasi. Kosongkan untuk repositori datar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separati da spazi. Lascia vuoto per un repository piatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペースで区切ります。フラットリポジトリの場合は空欄にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공백으로 구분합니다. 플랫 소스의 경우 비워 두십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separados por espaços. Deixe em branco para um repositório plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через пробел. Для плоского репозитория оставьте пустым."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zikitenganishwa kwa nafasi. Acha wazi kwa hazina bapa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşlukla ayırın. Düz depo için boş bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân tách bằng dấu cách. Để trống nếu là nguồn phẳng."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fi àyè yà wọ́n sọ́tọ̀. Fi í sílẹ̀ ní òfo fún ibi ìpamọ́ pẹrẹsẹ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用空格分隔。扁平软件源请留空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以空格分隔。扁平軟體源請留空。"
          }
        }
      }
    },
