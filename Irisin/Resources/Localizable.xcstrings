        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: kept at the current version by another package or a blocked update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: se mantiene en la versión actual por otro paquete o por una actualización bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : conservé à la version actuelle à cause d’un autre paquet ou d’une mise à jour bloquée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mantenuto alla versione attuale da un altro pacchetto o da un aggiornamento ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：ほかのパッケージまたはブロックしたアップデートにより、現在のバージョンのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 다른 패키지 또는 차단된 업데이트로 인해 현재 버전이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mantido na versão atual por outro pacote ou por uma atualização bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: оставлена текущая версия из-за другого пакета или заблокированного обновления."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: được giữ ở phiên bản hiện tại do một gói khác hoặc do cập nhật đã bị chặn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：因其他软件包或已屏蔽的更新而保持当前版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：因其他套件或已阻擋的更新而維持目前版本。"
          }
        }
      }
    },
    "%@: no version is available from its repository. Refresh the repository and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: لا يتوفر أي إصدار في مستودعها. حدّث المستودع وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: In der Quelle ist keine Version verfügbar. Aktualisiere die Quelle und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: no version is available from its repository. Refresh the repository and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: su repositorio no ofrece ninguna versión. Actualiza el repositorio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : aucune version n’est disponible dans son dépôt. Actualisez le dépôt et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nessuna versione disponibile nel suo repository. Aggiorna il repository e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：リポジトリに利用可能なバージョンがありません。リポジトリを更新して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 소스에서 사용할 수 있는 버전이 없습니다. 소스를 새로 고친 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nenhuma versão está disponível no repositório. Atualize o repositório e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: в репозитории нет доступных версий. Обновите репозиторий и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nguồn của gói không có phiên bản nào. Hãy làm mới nguồn rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：软件源中没有可用的版本。请刷新软件源后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：其軟體源沒有可用的版本。請重新整理軟體源後再試一次。"
          }
        }
      }
    },
