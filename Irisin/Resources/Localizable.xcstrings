    "Updating everything would remove installed packages. Update packages one at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي تحديث الكل إلى إزالة حزم مثبّتة. حدّث الحزم واحدة تلو الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব কিছু আপডেট করলে ইনস্টল করা প্যাকেজ সরে যাবে। প্যাকেজগুলি একটি একটি করে আপডেট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Aktualisieren aller Pakete würden installierte Pakete entfernt. Aktualisiere die Pakete einzeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updating everything would remove installed packages. Update packages one at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar todo desinstalaría paquetes instalados. Actualiza los paquetes de uno en uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout mettre à jour désinstallerait des paquets installés. Mettez à jour les paquets un par un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ अपडेट करने से इंस्टॉल किए गए पैकेज हट जाएँगे। पैकेज एक-एक करके अपडेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memperbarui semuanya akan membuang paket yang terinstal. Perbarui paket satu per satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornare tutto rimuoverebbe dei pacchetti installati. Aggiorna i pacchetti uno alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてをアップデートすると、インストール済みのパッケージが削除されます。パッケージを1つずつアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 업데이트하면 설치된 패키지가 제거됩니다. 패키지를 하나씩 업데이트하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar tudo removeria pacotes instalados. Atualize os pacotes um de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При обновлении всех пакетов будут удалены установленные пакеты. Обновляйте пакеты по одному."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusasisha kila kitu kungeondoa vifurushi vilivyosakinishwa. Sasisha vifurushi kimoja baada ya kingine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tümünü güncellemek yüklü paketleri kaldıracak. Paketleri tek tek güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cập nhật tất cả sẽ gỡ bỏ các gói đã cài đặt. Hãy cập nhật từng gói một."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣíṣe ìmúdójúìwọ̀n gbogbo rẹ̀ yóò yọ àwọn pákéèjì tí a ti fi sórí ẹ̀rọ kúrò. Ṣe ìmúdójúìwọ̀n àwọn pákéèjì ní ọ̀kọ̀ọ̀kan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部更新会卸载已安装的软件包。请逐个更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部更新會解除安裝已安裝的套件。請逐一更新套件。"
          }
        }
      }
    },
