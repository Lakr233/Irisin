        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn này không có gói nào ở lần làm mới gần nhất. Có thể địa chỉ bị sai, hoặc máy chủ đang ngừng hoạt động."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn ibi ìpamọ́ wọ̀nyí kò ní àpò kankan nígbà tí a sọ wọ́n dọ̀tun kẹ́yìn. Àdírẹ́sì náà lè jẹ́ àṣìṣe, tàbí kí olupin náà má ṣiṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
