        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn này được sử dụng rộng rãi. Chúng tôi khuyên bạn nên bắt đầu từ đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
