    "%@ requires %@, which is not available. Add a repository that provides it and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب %1$@ الحزمة %2$@، وهي غير متوفرة. أضِف مستودعًا يوفرها وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-এর জন্য %2$@ প্রয়োজন, কিন্তু সেটি পাওয়া যাচ্ছে না। যে রিপোজিটরি এটি সরবরাহ করে সেটি যোগ করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ benötigt %2$@, aber dieses Paket ist nicht verfügbar. Füge eine Quelle hinzu, die es bereitstellt, und versuche es erneut."
