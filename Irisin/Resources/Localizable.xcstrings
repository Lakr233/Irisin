          }
        }
      }
    },
    "These were installed as dependencies and nothing needs them now. Tick one to remove it with the queue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبّتت هذه الحزم كتبعيات ولم تعد أي حزمة تحتاج إليها. حدّد إحداها لإزالتها مع قائمة الانتظار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Pakete wurden als Abhängigkeiten installiert und werden nicht mehr benötigt. Markiere eines, um es mit der Warteschlange zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These were installed as dependencies and nothing needs them now. Tick one to remove it with the queue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se instalaron como dependencias y ya ningún paquete los necesita. Marca uno para desinstalarlo con la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces paquets ont été installés comme dépendances et ne sont plus nécessaires. Cochez-en un pour le désinstaller avec la file d’attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi pacchetti sono stati installati come dipendenze e ora non servono più. Selezionane uno per rimuoverlo con la coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは依存関係としてインストールされ、現在はどのパッケージにも必要とされていません。チェックを付けると、キューと一緒に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의존성으로 설치되었지만 이제 필요한 패키지가 없는 항목입니다. 선택하면 대기열과 함께 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes pacotes foram instalados como dependências e nada mais precisa deles. Marque um para removê-lo com a fila."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти пакеты были установлены как зависимости и больше ничему не нужны. Отметьте пакет, чтобы удалить его вместе с очередью."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói này được cài đặt làm phụ thuộc và hiện không còn gói nào cần đến. Đánh dấu một gói để gỡ bỏ cùng hàng đợi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些软件包是作为依赖自动安装的，现在没有别的软件包需要它们。勾选后会随队列一并卸载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些套件是作為相依套件安裝的，目前已沒有其他套件需要。勾選後即會隨佇列一併解除安裝。"
          }
        }
      }
    },
    "This copy of Irisin is built for %@, but your bootstrap uses %@. Install the matching official Irisin package. Do not install Irisin using a patcher." : {
      "comment" : "Startup is blocked because the architecture stamped in this Irisin package differs from the detected bootstrap. The placeholders are dpkg architecture names, in that order.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صُممت هذه النسخة من Irisin للعمل مع %@، لكن البرنامج الثابت المخصص لديك تستخدم %@. ثبّت حزمة Irisin الرسمية المطابقة لبيئتك. لا تثبّت Irisin باستخدام أداة لتعديل الحزم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von Irisin wurde für %@ erstellt, aber Ihre Bootstrap-Umgebung verwendet %@. Installieren Sie das passende offizielle Irisin-Paket. Installieren Sie Irisin nicht mithilfe eines Patchers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of Irisin is built for %@, but your bootstrap uses %@. Install the matching official Irisin package. Do not install Irisin using a patcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de Irisin está compilada para %@, pero tu firmware personalizado usa %@. Instala el paquete oficial de Irisin correspondiente. No instales Irisin con una herramienta de parcheo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version d’Irisin est conçue pour %@, mais votre firmware personnalisé utilise %@. Installez le paquet officiel Irisin correspondant à votre environnement. N’installez pas Irisin à l’aide d’un outil de conversion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia di Irisin è stata compilata per %@, ma il bootstrap del dispositivo usa %@. Installa il pacchetto ufficiale di Irisin compatibile con il bootstrap. Non installare Irisin utilizzando un patcher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Irisin は %@ 向けにビルドされていますが、現在のカスタムファームウェアは %@ を使用しています。お使いの環境に対応する公式の Irisin パッケージをインストールしてください。パッチャーを使用して Irisin をインストールしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Irisin 패키지는 %@용으로 빌드되었지만, 현재 커스텀 펌웨어는 %@을(를) 사용합니다. 현재 환경에 맞는 공식 Irisin 패키지를 설치하세요. 패처를 사용하여 Irisin을 설치하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia do Irisin foi criada para %@, mas seu firmware personalizado usa %@. Instale o pacote oficial do Irisin compatível com seu ambiente. Não instale o Irisin usando uma ferramenta de adaptação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия Irisin собрана для архитектуры %@, но ваша кастомная прошивка использует %@. Установите официальный пакет Irisin для вашей среды. Не устанавливайте Irisin с помощью патчера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản Irisin này được xây dựng cho %@, nhưng firmware tùy chỉnh của bạn sử dụng %@. Hãy cài đặt gói Irisin chính thức phù hợp. Không cài đặt Irisin bằng công cụ vá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Irisin 安装包适用于 %@，但当前自定义固件使用 %@。请安装与当前环境匹配的 Irisin 官方安装包。请勿使用转换工具安装 Irisin。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Irisin 安裝套件適用於 %@，但目前的自訂韌體使用 %@。請安裝與目前環境相符的 Irisin 官方安裝套件。請勿使用轉換工具安裝 Irisin。"
          }
        }
      }
    },
