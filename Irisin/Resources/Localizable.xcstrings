          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti dei repository eliminati non verranno più elencati. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したリポジトリのパッケージは表示されなくなります。この操作は取り消せません。"
