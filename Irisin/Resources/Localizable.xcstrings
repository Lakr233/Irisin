    "Go back and choose Try Again to finish setting up this package." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارجع واختر «حاول مرة أخرى» لإكمال تهيئة هذه الحزمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্যাকেজের সেট আপ সম্পন্ন করতে ফিরে গিয়ে “আবার চেষ্টা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh zurück und wähle „Erneut versuchen“, um die Einrichtung dieses Pakets abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go back and choose Try Again to finish setting up this package."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve atrás y elige “Volver a intentarlo” para terminar de configurar este paquete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez en arrière et choisissez « Réessayer » pour terminer la configuration de ce paquet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस जाएँ और इस पैकेज का सेटअप पूरा करने के लिए “फिर से कोशिश करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali dan pilih Coba Lagi untuk menyelesaikan konfigurasi paket ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna indietro e scegli “Riprova” per completare la configurazione di questo pacchetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパッケージの設定を完了するには、前の画面に戻って「もう一度試す」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패키지의 구성을 완료하려면 이전 화면으로 돌아가 ‘다시 시도’를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte e escolha “Tentar novamente” para concluir a configuração deste pacote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь назад и выберите «Повторить попытку», чтобы завершить настройку этого пакета."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rudi nyuma na uchague Jaribu Tena ili kukamilisha kusanidi kifurushi hiki."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu paketin yapılandırmasını tamamlamak için geri dönüp “Yeniden Dene”yi seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy quay lại và chọn “Thử lại” để hoàn tất cấu hình gói này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padà sẹ́yìn kí o sì yan Gbìyànjú Lẹ́ẹ̀kansí láti parí ṣíṣètò pákéèjì yìí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请返回并选择“再试一次”，以完成此软件包的配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請返回並選擇「再試一次」，以完成此套件的設定。"
          }
        }
      }
    },
