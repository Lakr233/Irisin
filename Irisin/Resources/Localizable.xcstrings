    "These repositories are widely used. We recommend starting here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المستودعات واسعة الاستخدام، وننصحك بالبدء منها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই রিপোজিটরিগুলি ব্যাপকভাবে ব্যবহৃত হয়। আমরা এখান থেকে শুরু করার পরামর্শ দিই।"
          }
        },
        "de" : {
