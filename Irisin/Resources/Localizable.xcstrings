          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ конфликтует с %2$@. Уберите один из пакетов и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ xung đột với %2$@. Hãy bỏ một trong hai gói rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 与 %2$@ 冲突。请移除其中一个后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 與 %2$@ 衝突。請移除其中一個後再試一次。"
          }
        }
      }
    },
    "%@ could not be resolved to a single version. Clear the queue and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحديد إصدار واحد لـ %@. امسح قائمة الانتظار وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ konnte keine eindeutige Version bestimmt werden. Leere die Warteschlange und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not be resolved to a single version. Clear the queue and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido determinar una única versión de %@. Vacía la cola e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer une version unique pour %@. Videz la file d’attente et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile determinare una sola versione per %@. Svuota la coda e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のバージョンを1つに決定できませんでした。キューを消去して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 패키지의 버전을 하나로 정할 수 없습니다. 대기열을 비운 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
