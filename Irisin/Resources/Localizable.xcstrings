    "Unable to resolve the packages. Review the queue and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حل تبعيات الحزم. راجِع قائمة الانتظار وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাকেজগুলির সমাধান করা যায়নি। সারিটি পর্যালোচনা করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
