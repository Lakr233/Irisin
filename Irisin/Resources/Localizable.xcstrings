    "%@ did not finish installing. Install it again to repair it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل تثبيت %@. ثبّتها مرة أخرى لإصلاحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation von %@ wurde nicht abgeschlossen. Installiere das Paket erneut, um es zu reparieren."
          }
        },
