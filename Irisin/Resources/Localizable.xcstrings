    "This package was unpacked, but the operation stopped at another package before this one was set up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فك ضغط هذه الحزمة، لكن العملية توقفت عند حزمة أخرى قبل تهيئتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Paket wurde entpackt, aber der Vorgang wurde bei einem anderen Paket abgebrochen, bevor dieses eingerichtet war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This package was unpacked, but the operation stopped at another package before this one was set up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este paquete se ha desempaquetado, pero la operación se detuvo en otro paquete antes de configurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paquet a été décompressé, mais l’opération s’est arrêtée sur un autre paquet avant qu’il ne soit configuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo pacchetto è stato estratto, ma l’operazione si è interrotta su un altro pacchetto prima che questo venisse configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパッケージは展開されましたが、設定される前に別のパッケージで操作が停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패키지는 압축 해제되었지만, 구성되기 전에 다른 패키지에서 작업이 중단되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pacote foi desempacotado, mas a operação parou em outro pacote antes que este fosse configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот пакет распакован, но операция остановилась на другом пакете до его настройки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói này đã được giải nén nhưng thao tác đã dừng ở một gói khác trước khi gói này được cấu hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此软件包已解压，但操作在另一个软件包处停止，它尚未配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
