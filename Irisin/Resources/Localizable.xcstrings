    "Fila opens folders and files on this device. It comes from the OwnGoal Studio repository." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Fila المجلدات والملفات على هذا الجهاز، ويتوفر من مستودع OwnGoal Studio."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila এই ডিভাইসের ফোল্ডার ও ফাইল খোলে। এটি OwnGoal Studio রিপোজিটরি থেকে পাওয়া যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila öffnet Ordner und Dateien auf diesem Gerät. Die App stammt aus der Quelle von OwnGoal Studio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila opens folders and files on this device. It comes from the OwnGoal Studio repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila abre carpetas y archivos de este dispositivo. Está disponible en el repositorio de OwnGoal Studio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila ouvre les dossiers et fichiers de cet appareil. Cette app est proposée par le dépôt OwnGoal Studio."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila इस डिवाइस पर फ़ोल्डर और फ़ाइलें खोलता है। यह OwnGoal Studio रिपॉज़िटरी से मिलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila membuka folder dan file di perangkat ini. Fila tersedia dari repositori OwnGoal Studio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila apre cartelle e file su questo dispositivo. È disponibile nel repository di OwnGoal Studio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filaはこのデバイス上のフォルダやファイルを開くAppです。OwnGoal Studioのリポジトリから入手できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila는 이 기기의 폴더와 파일을 엽니다. OwnGoal Studio 소스에서 제공됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fila abre pastas e arquivos neste dispositivo. Ele vem do repositório OwnGoal Studio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila открывает папки и файлы на этом устройстве. Приложение доступно в репозитории OwnGoal Studio."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila hufungua folda na faili kwenye kifaa hiki. Inapatikana kutoka hazina ya OwnGoal Studio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila, bu aygıttaki klasörleri ve dosyaları açar. OwnGoal Studio deposundan edinilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila mở thư mục và tệp trên thiết bị này. Ứng dụng có trong nguồn OwnGoal Studio."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila ń ṣí àwọn fódà àti àwọn fáìlì lórí ẹ̀rọ yìí. Ó wá láti ibi ìpamọ́ OwnGoal Studio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila 用于打开设备上的文件夹和文件，可从 OwnGoal Studio 软件源安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila 可打開此裝置上的檔案夾和檔案，可從 OwnGoal Studio 軟體源取得。"
          }
        }
      }
    },
