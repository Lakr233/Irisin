          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket ist weiterhin installiert. Geh zurück und wähle „Erneut versuchen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
