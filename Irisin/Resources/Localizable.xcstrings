    "No added repository offers “%@”. Add the repository that has it, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر أي مستودع مضاف «%@». أضف المستودع الذي يحتوي عليه ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যোগ করা কোনো রিপোজিটরি “%@” দেয় না। যে রিপোজিটরিতে এটি আছে সেটি যোগ করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine hinzugefügte Quelle bietet „%@“ an. Füge die Quelle hinzu, die es enthält, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No added repository offers “%@”. Add the repository that has it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún repositorio añadido ofrece «%@». Añade el repositorio que lo tenga e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun dépôt ajouté ne propose « %@ ». Ajoutez le dépôt qui le contient, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी जोड़ी गई रिपॉज़िटरी “%@” उपलब्ध नहीं कराती। जिस रिपॉज़िटरी में यह है, उसे जोड़ें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada repositori yang ditambahkan yang menawarkan “%@”. Tambahkan repositori yang memilikinya, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun repository aggiunto offre “%@”. Aggiungi il repository che lo contiene e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加済みのリポジトリに「%@」はありません。提供しているリポジトリを追加してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가된 소스 중에 “%@” 패키지를 제공하는 곳이 없습니다. 해당 패키지가 있는 소스를 추가한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum repositório adicionado oferece “%@”. Adicione o repositório que o contém e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один добавленный репозиторий не предлагает «%@». Добавьте репозиторий с этим пакетом и повторите попытку."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuna hazina iliyoongezwa inayotoa “%@”. Ongeza hazina iliyo nayo, kisha ujaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklenen depoların hiçbiri “%@” paketini sunmuyor. Bu paketi sunan depoyu ekleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không nguồn nào đã thêm cung cấp “%@”. Hãy thêm nguồn có gói này rồi thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kò sí ibi ìpamọ́ tí a ṣàfikún tí ó ń pèsè “%@”. Ṣàfikún ibi ìpamọ́ tí ó ní in, kí o sì gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加的软件源都不提供“%@”。请添加提供它的软件源，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加入的軟體源都不提供「%@」。請加入提供它的軟體源，然後再試一次。"
          }
        }
      }
    },
