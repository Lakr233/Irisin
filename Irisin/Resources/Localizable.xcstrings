    "Packages were changed, but the home screen was not updated. Choose Rebuild Icons to try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير الحزم، لكن لم يتم تحديث الشاشة الرئيسية. اختر «إعادة بناء الأيقونات» للمحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pakete wurden geändert, aber der Home-Bildschirm wurde nicht aktualisiert. Wähle „Symbole neu erstellen“, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages were changed, but the home screen was not updated. Choose Rebuild Icons to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes se han modificado, pero la pantalla de inicio no se ha actualizado. Elige “Regenerar iconos” para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paquets ont été modifiés, mais l’écran d’accueil n’a pas été mis à jour. Choisissez « Reconstruire les icônes » pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti sono stati modificati, ma la schermata Home non è stata aggiornata. Scegli “Ricostruisci icone” per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージは変更されましたが、ホーム画面は更新されませんでした。「アイコンを再構築」を選択して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지가 변경되었지만 홈 화면이 업데이트되지 않았습니다. 다시 시도하려면 ‘아이콘 재생성’을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pacotes foram alterados, mas a Tela de Início não foi atualizada. Escolha “Reconstruir ícones” para tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты изменены, но экран «Домой» не обновлен. Выберите «Пересоздать значки», чтобы повторить попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói đã được thay đổi nhưng Màn hình chính chưa được cập nhật. Hãy chọn “Tạo lại biểu tượng” để thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "软件包已更改，但主屏幕未更新。请选择“重建图标”重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件已變更，但主畫面未更新。請選擇「重建圖像」再試一次。"
          }
        }
      }
    },
