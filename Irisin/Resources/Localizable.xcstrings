    "Packages from deleted repositories will no longer be listed. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تظهر حزم المستودعات المحذوفة بعد الآن. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakete aus gelöschten Quellen werden nicht mehr angezeigt. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages from deleted repositories will no longer be listed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes de los repositorios eliminados dejarán de mostrarse. Esta acción no se puede deshacer."
