    "Download a tweak's package file to keep or share." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل ملف حزمة الإضافة للاحتفاظ به أو مشاركته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষণ বা শেয়ার করার জন্য টুইকের প্যাকেজ ফাইল ডাউনলোড করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade die Paketdatei eines Tweaks herunter, um sie zu behalten oder zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download a tweak's package file to keep or share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el archivo .deb de un tweak para guardarlo o compartirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez l’archive d’une extension pour la conserver ou la partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी ट्वीक की पैकेज फ़ाइल रखने या शेयर करने के लिए डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh file paket tweak untuk disimpan atau dibagikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica il file del pacchetto di un tweak per conservarlo o condividerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweak のパッケージファイルをダウンロードして、保存・共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트윅의 패키지 파일을 다운로드하여 보관하거나 공유합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe o arquivo do pacote de um tweak para guardar ou compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите архив твика, чтобы сохранить его или поделиться им."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakua faili ya kifurushi cha programu-jalizi ili kuihifadhi au kuishiriki."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saklamak veya paylaşmak için bir eklentinin paket dosyasını indirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải xuống tệp gói của tweak để lưu giữ hoặc chia sẻ."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣe ìgbàsílẹ̀ fáìlì pákéèjì tíwíìkì kan láti pa mọ́ tàbí láti pín."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载插件的安装包，以便留存或分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載外掛的安裝檔，以便留存或分享。"
          }
        }
      }
    },
