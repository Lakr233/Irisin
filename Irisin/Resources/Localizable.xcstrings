    "Repositories that could not be loaded will be removed. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة المستودعات التي تعذر تحميلها. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে রিপোজিটরিগুলি লোড করা যায়নি সেগুলি সরানো হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen, die nicht geladen werden konnten, werden entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositories that could not be loaded will be removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitarán los repositorios que no se han podido cargar. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépôts qui n’ont pas pu être chargés seront supprimés. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो रिपॉज़िटरी लोड नहीं हो सकीं, उन्हें हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositori yang tidak dapat dimuat akan dibuang. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I repository che non è stato possibile caricare verranno rimossi. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込めなかったリポジトリは削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불러올 수 없는 소스가 제거됩니다. 이 동작은 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os repositórios que não puderam ser carregados serão removidos. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Репозитории, которые не удалось загрузить, будут удалены. Это действие нельзя отменить."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazina ambazo hazikuweza kupakiwa zitaondolewa. Kitendo hiki hakiwezi kutenduliwa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgileri alınamayan depolar kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn không tải được sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ó yọ àwọn ibi ìpamọ́ tí a kò lè gbé kalẹ̀ kúrò. A kò lè dá èyí padà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除无法加载的软件源。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入的軟體源將被移除。此動作無法復原。"
          }
        }
      }
    },
