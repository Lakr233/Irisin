          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói này chưa được cài đặt hoàn chỉnh. Hãy cài đặt lại để sửa hoặc gỡ bỏ gói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
