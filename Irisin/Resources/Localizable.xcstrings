          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने वर्ज़न %1$@ चुना है। %2$@ वर्ज़न %3$@ उपलब्ध कराता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memilih versi %1$@. %2$@ menawarkan versi %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato la versione %1$@. %2$@ offre la versione %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %1$@ を選択しました。%2$@ にはバージョン %3$@ があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전 %1$@을(를) 선택했습니다. %2$@에서 버전 %3$@을(를) 제공합니다."
