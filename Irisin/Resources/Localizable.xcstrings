    "Removing a package the system requires can stop the custom firmware or this app from working." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تؤدي إزالة حزمة يحتاجها النظام إلى توقف البرنامج الثابت المخصص أو هذا التطبيق عن العمل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিস্টেমের প্রয়োজনীয় কোনো প্যাকেজ সরালে কাস্টম ফার্মওয়্যার বা এই অ্যাপ কাজ করা বন্ধ করে দিতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Systempaket entfernst, funktionieren die Custom Firmware oder diese App möglicherweise nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing a package the system requires can stop the custom firmware or this app from working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desinstalar un paquete que el sistema requiere puede hacer que el firmware personalizado o esta app dejen de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désinstaller un paquet requis par le système peut empêcher le firmware personnalisé ou cette app de fonctionner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम के लिए ज़रूरी पैकेज हटाने से कस्टम फ़र्मवेयर या यह ऐप काम करना बंद कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuang paket yang diperlukan sistem dapat membuat firmware kustom atau app ini berhenti berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere un pacchetto richiesto dal sistema può impedire il funzionamento del firmware personalizzato o di questa app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムに必要なパッケージを削除すると、カスタムファームウェアやこのAppが動作しなくなる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템에 필요한 패키지를 제거하면 커스텀 펌웨어나 이 앱이 작동하지 않을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover um pacote exigido pelo sistema pode fazer com que o firmware personalizado ou este app deixe de funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление пакета, необходимого системе, может нарушить работу кастомной прошивки или этого приложения."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuondoa kifurushi kinachohitajika na mfumo kunaweza kufanya programu dhibiti maalum au programu hii isifanye kazi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemin gerektirdiği bir paketi kaldırmak özel donanım yazılımının veya bu uygulamanın çalışmasını durdurabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gỡ bỏ gói mà hệ thống cần có thể khiến firmware tùy chỉnh hoặc ứng dụng này ngừng hoạt động."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yíyọ pákéèjì tí sísítẹ́mù nílò kúrò lè mú kí fámúwẹ́à àdáni tàbí àpù yìí dẹ́kun ṣíṣiṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载系统必需的软件包可能导致自定义固件或本应用无法工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除安裝系統必需的套件，可能會導致自訂韌體或此 App 無法運作。"
          }
        }
      }
    },
