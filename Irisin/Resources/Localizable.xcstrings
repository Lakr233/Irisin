          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выбрать одну версию для %@. Очистите очередь и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác định một phiên bản duy nhất cho %@. Hãy xóa hàng đợi rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确定 %@ 应使用的版本。请清空队列后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確定 %@ 要使用的版本。請清除佇列後再試一次。"
          }
        }
      }
    },
    "%@ did not finish installing. Install it again before making other changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل تثبيت %@. ثبّتها مرة أخرى قبل إجراء تغييرات أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation von %@ wurde nicht abgeschlossen. Installiere das Paket erneut, bevor du andere Änderungen vornimmst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ did not finish installing. Install it again before making other changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instalación de %@ no terminó. Vuelve a instalarlo antes de hacer otros cambios."
