    "Recovery Mode" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع الاسترداد"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুনরুদ্ধার মোড"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellungsmodus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery Mode"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo de recuperación"
          }
        },
        "fr" : {
          "stringUnit" : {
