          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ нельзя установить в режиме совместимости: он не преобразует %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cài đặt %1$@ ở chế độ tương thích, vốn không chuyển đổi %2$@."
