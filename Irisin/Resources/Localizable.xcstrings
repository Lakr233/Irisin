    "%@ %@: the repository sent unreadable package information. Refresh the repository and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: أرسل المستودع معلومات حزمة تتعذر قراءتها. حدّث المستودع وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: Die Quelle hat unlesbare Paketinformationen gesendet. Aktualisiere die Quelle und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: the repository sent unreadable package information. Refresh the repository and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: el repositorio envió información del paquete que no se puede leer. Actualiza el repositorio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ : le dépôt a fourni des informations de paquet illisibles. Actualisez le dépôt et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: le informazioni sul pacchetto inviate dal repository non sono leggibili. Aggiorna il repository e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：リポジトリから読み取れないパッケージ情報が送られました。リポジトリを更新して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: 소스에서 받은 패키지 정보를 읽을 수 없습니다. 소스를 새로 고친 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: o repositório enviou informações de pacote ilegíveis. Atualize o repositório e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: репозиторий передал нечитаемые сведения о пакете. Обновите репозиторий и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: nguồn đã gửi thông tin gói không đọc được. Hãy làm mới nguồn rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：软件源提供的软件包信息无法读取。请刷新软件源后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@：軟體源提供的套件資訊無法讀取。請重新整理軟體源後再試一次。"
          }
        }
      }
    },
    "%@ cannot be installed in compatibility mode, which does not convert %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تثبيت %1$@ في وضع التوافق، الذي لا يحوّل %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann nicht im Kompatibilitätsmodus installiert werden, der %2$@ nicht umwandelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cannot be installed in compatibility mode, which does not convert %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no se puede instalar en el modo de compatibilidad, que no convierte %2$@."
