        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지가 일부만 설치되었습니다. 다시 설치하여 복구하거나 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
