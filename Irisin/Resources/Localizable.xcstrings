    "%@ conflicts with %@. Remove one of them and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعارض %1$@ مع %2$@. أزِل إحداهما وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-এর সাথে %2$@-এর দ্বন্দ্ব রয়েছে। যেকোনো একটি সরিয়ে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ steht im Konflikt mit %2$@. Entferne eines der beiden Pakete und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ conflicts with %2$@. Remove one of them and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entra en conflicto con %2$@. Quita uno de los dos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est en conflit avec %2$@. Retirez l’un des deux et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का %2$@ से टकराव है। इनमें से एक को हटाएँ और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ berkonflik dengan %2$@. Buang salah satunya, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è in conflitto con %2$@. Rimuovine uno e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ と %2$@ が競合しています。どちらかを削除して、もう一度お試しください。"
          }
