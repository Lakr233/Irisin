        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैकेज आधा इंस्टॉल हुआ है। इसे ठीक करने के लिए दोबारा इंस्टॉल करें, या इसे हटा दें।"
