          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：因其他套件或已阻擋的更新而維持目前版本。"
          }
        }
      }
    },
    "%@: no version is available from its repository. Refresh the repository and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: لا يتوفر أي إصدار في مستودعها. حدّث المستودع وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: এর রিপোজিটরিতে কোনো সংস্করণ পাওয়া যাচ্ছে না। রিপোজিটরি রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: In der Quelle ist keine Version verfügbar. Aktualisiere die Quelle und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: no version is available from its repository. Refresh the repository and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: su repositorio no ofrece ninguna versión. Actualiza el repositorio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : aucune version n’est disponible dans son dépôt. Actualisez le dépôt et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: इसकी रिपॉज़िटरी से कोई वर्ज़न उपलब्ध नहीं है। रिपॉज़िटरी रीफ़्रेश करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tidak ada versi yang tersedia dari repositorinya. Segarkan repositori, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nessuna versione disponibile nel suo repository. Aggiorna il repository e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：リポジトリに利用可能なバージョンがありません。リポジトリを更新して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 소스에서 사용할 수 있는 버전이 없습니다. 소스를 새로 고친 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nenhuma versão está disponível no repositório. Atualize o repositório e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: в репозитории нет доступных версий. Обновите репозиторий и повторите попытку."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: hakuna toleo linalopatikana kutoka hazina yake. Onyesha upya hazina kisha ujaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Deposunda kullanılabilir sürüm yok. Depoyu yenileyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nguồn của gói không có phiên bản nào. Hãy làm mới nguồn rồi thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: kò sí ẹ̀yà kankan láti ibi ìpamọ́ rẹ̀. Sọ ibi ìpamọ́ náà dọ̀tun kí o sì gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：软件源中没有可用的版本。请刷新软件源后重试。"
