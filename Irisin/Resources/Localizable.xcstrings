    "Nothing was changed for this package. Remove it from the queue and add it again to download a fresh copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتغير شيء في هذه الحزمة. أزِلها من قائمة الانتظار ثم أضِفها مرة أخرى لتنزيل نسخة جديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্যাকেজের জন্য কিছু পরিবর্তন হয়নি। নতুন কপি ডাউনলোড করতে এটিকে সারি থেকে সরিয়ে আবার যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An diesem Paket wurde nichts geändert. Entferne es aus der Warteschlange und füge es erneut hinzu, um es neu herunterzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was changed for this package. Remove it from the queue and add it again to download a fresh copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha cambiado nada en este paquete. Quítalo de la cola y vuelve a añadirlo para descargar una copia nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paquet n’a pas été modifié. Retirez-le de la file d’attente, puis ajoutez-le à nouveau pour en télécharger une nouvelle copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पैकेज में कुछ भी नहीं बदला गया। नई प्रति डाउनलोड करने के लिए इसे कतार से हटाएँ और फिर से जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang diubah pada paket ini. Buang dari antrean, lalu tambahkan lagi untuk mengunduh salinan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo pacchetto non è stato modificato. Rimuovilo dalla coda e aggiungilo di nuovo per scaricarne una nuova copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパッケージは変更されていません。キューから削除してもう一度追加し、新しいコピーをダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패키지는 변경되지 않았습니다. 대기열에서 제거한 후 다시 추가하여 새로 다운로드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi alterado neste pacote. Remova-o da fila e adicione-o novamente para baixar uma nova cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот пакет не изменен. Уберите его из очереди и добавьте снова, чтобы загрузить новую копию."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuna kilichobadilishwa kwa kifurushi hiki. Kiondoe kwenye foleni kisha ukiongeze tena ili kupakua nakala mpya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu paket için hiçbir şey değişmedi. Yeni bir kopya indirmek için paketi kuyruktan kaldırıp yeniden ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói này chưa bị thay đổi gì. Hãy xóa gói khỏi hàng đợi rồi thêm lại để tải xuống bản mới."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kò sí ohun tí ó yí padà fún pákéèjì yìí. Yọ ọ́ kúrò nínú ìtòsẹ́ kí o sì tún ṣàfikún rẹ̀ láti ṣe ìgbàsílẹ̀ ẹ̀dà tuntun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此软件包没有任何改动。请将它移出队列后重新添加，以下载新的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此套件未做任何變更。請將它從佇列移除後重新加入，以下載新的副本。"
          }
        }
      }
    },
