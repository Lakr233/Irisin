    "The package is half-installed. Install it again to repair it, or remove it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزمة مثبّتة جزئيًا. ثبّتها مرة أخرى لإصلاحها، أو أزِلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket ist nur teilweise installiert. Installiere es erneut, um es zu reparieren, oder entferne es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The package is half-installed. Install it again to repair it, or remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete está instalado a medias. Vuelve a instalarlo para repararlo o desinstálalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paquet est partiellement installé. Réinstallez-le pour le réparer, ou désinstallez-le."
          }
        },
        "it" : {
          "stringUnit" : {
