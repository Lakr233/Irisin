    "The %@ script of %@ failed with exit status %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل النص البرمجي %1$@ للحزمة %2$@ برمز الخروج %3$lld."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@-এর %1$@ স্ক্রিপ্ট ব্যর্থ হয়েছে, এক্সিট স্ট্যাটাস %3$lld।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Skript %1$@ von %2$@ ist mit dem Exit-Status %3$lld fehlgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ script of %2$@ failed with exit status %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El script %1$@ de %2$@ ha fallado con el código de salida %3$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le script %1$@ de %2$@ a échoué avec le code de sortie %3$lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ की %1$@ स्क्रिप्ट एग्ज़िट स्टेटस %3$lld के साथ विफल रही।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrip %1$@ dari %2$@ gagal dengan status keluar %3$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo script %1$@ di %2$@ non è riuscito con stato di uscita %3$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ の %1$@ スクリプトが終了ステータス %3$lld で失敗しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 %1$@ 스크립트가 종료 상태 %3$lld(으)로 실패했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O script %1$@ de %2$@ falhou com o status de saída %3$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипт %1$@ пакета %2$@ завершился с кодом %3$lld."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hati ya %1$@ ya %2$@ imeshindwa na hali ya kutoka %3$lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ paketinin %1$@ betiği %3$lld çıkış durumuyla başarısız oldu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập lệnh %1$@ của %2$@ bị lỗi với mã thoát %3$lld."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síkírípítì %1$@ ti %2$@ kùnà pẹ̀lú ipò ìjáde %3$lld."
