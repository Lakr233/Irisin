    "An update to a package installed in compatibility mode is converted again. It may stop working and damage the system." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحوَّل تحديث الحزمة المثبَّتة في وضع التوافق من جديد. قد تتوقف عن العمل وتُلحق الضرر بالنظام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সামঞ্জস্য মোডে ইনস্টল করা প্যাকেজের আপডেট আবার রূপান্তর করা হয়। এটি কাজ করা বন্ধ করে দিতে পারে এবং সিস্টেমের ক্ষতি করতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Update für ein im Kompatibilitätsmodus installiertes Paket wird erneut konvertiert. Es funktioniert danach möglicherweise nicht mehr und kann das System beschädigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An update to a package installed in compatibility mode is converted again. It may stop working and damage the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización de un paquete instalado en el modo de compatibilidad se convierte de nuevo. Puede dejar de funcionar y dañar el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour d’un paquet installé en mode de compatibilité est convertie à nouveau. Il peut cesser de fonctionner et endommager le système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुकूलता मोड में इंस्टॉल किए गए पैकेज का अपडेट फिर से रूपांतरित किया जाता है। यह काम करना बंद कर सकता है और सिस्टम को नुकसान पहुँचा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan untuk paket yang diinstal dalam mode kompatibilitas akan dikonversi lagi. Paket tersebut mungkin berhenti berfungsi dan merusak sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aggiornamento di un pacchetto installato in modalità compatibilità viene convertito di nuovo. Potrebbe smettere di funzionare e danneggiare il sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換モードでインストールしたパッケージのアップデートは、再度変換されます。動作しなくなり、システムが損傷する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환 모드로 설치한 패키지의 업데이트는 다시 변환됩니다. 작동이 중단되고 시스템이 손상될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização de um pacote instalado no modo de compatibilidade é convertida novamente. Ele pode parar de funcionar e danificar o sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление пакета, установленного в режиме совместимости, конвертируется заново. Пакет может перестать работать и повредить систему."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasisho la kifurushi kilichosakinishwa katika hali ya uoanifu hubadilishwa tena. Huenda kikaacha kufanya kazi na kuharibu mfumo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumluluk modunda yüklenen bir paketin güncellemesi yeniden dönüştürülür. Paket çalışmayı durdurabilir ve sisteme zarar verebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản cập nhật của gói được cài đặt ở chế độ tương thích sẽ được chuyển đổi lại. Gói có thể ngừng hoạt động và làm hỏng hệ thống."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìmúdójúìwọ̀n sí pákéèjì tí a fi sórí ẹ̀rọ ní ìpò ìbáramu ni a ó tún yí padà lẹ́ẹ̀kansí. Ó lè dẹ́kun iṣẹ́, kí ó sì ba sísítẹ́mù jẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以兼容模式安装的软件包在更新时会被重新转换。更新后可能无法工作，并导致系统损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以相容模式安裝的套件在更新時會重新轉換。更新後可能無法運作，並導致系統損壞。"
          }
        }
      }
    },
    "Another operation is already running. Wait for it to finish, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك عملية أخرى قيد التنفيذ. انتظر حتى تنتهي، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরেকটি অপারেশন ইতিমধ্যে চলছে। সেটি শেষ হওয়া পর্যন্ত অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Vorgang läuft bereits. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another operation is already running. Wait for it to finish, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay otra operación en curso. Espera a que termine e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre opération est déjà en cours. Attendez qu’elle se termine, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक अन्य ऑपरेशन पहले से चल रहा है। उसके पूरा होने की प्रतीक्षा करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operasi lain sedang berjalan. Tunggu hingga selesai, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso un’altra operazione. Attendi che termini, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの操作を実行中です。完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
