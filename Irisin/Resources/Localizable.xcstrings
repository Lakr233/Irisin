          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifurushi vimebadilika. Kagua mabadiliko kisha ujaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketler değişti. Değişiklikleri gözden geçirip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói đã thay đổi. Hãy xem lại các thay đổi rồi thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn pákéèjì ti yí padà. Ṣàyẹ̀wò àwọn àyípadà náà kí o sì gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
