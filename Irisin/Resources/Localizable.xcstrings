    "These repositories had no packages at their last refresh. The address may be wrong, or the server may be down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تكن في هذه المستودعات أي حزم عند آخر تحديث. قد يكون العنوان خاطئًا، أو قد يكون الخادم متوقفًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষবার রিফ্রেশের সময় এই রিপোজিটরিগুলোতে কোনো প্যাকেজ ছিল না। ঠিকানাটি ভুল হতে পারে, অথবা সার্ভারটি বন্ধ থাকতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quellen hatten bei der letzten Aktualisierung keine Pakete. Die Adresse ist vielleicht falsch, oder der Server ist nicht erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These repositories had no packages at their last refresh. The address may be wrong, or the server may be down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos repositorios no tenían paquetes en su última actualización. Puede que la dirección sea incorrecta o que el servidor no esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces dépôts ne contenaient aucun paquet lors de leur dernière actualisation. L’adresse est peut-être erronée, ou le serveur est peut-être hors service."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली बार रीफ़्रेश करने पर इन रिपॉज़िटरी में कोई पैकेज नहीं था। हो सकता है पता गलत हो, या सर्वर बंद हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
