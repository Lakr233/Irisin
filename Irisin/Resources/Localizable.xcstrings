    "Irisin is not installed correctly. Reinstall it and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُثبَّت Irisin بشكل صحيح. أعِد تثبيته وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin সঠিকভাবে ইনস্টল করা নেই। এটি আবার ইনস্টল করে তারপর চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin ist nicht richtig installiert. Installiere Irisin neu und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin is not installed correctly. Reinstall it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin no se ha instalado correctamente. Vuelve a instalar Irisin e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin n’est pas installé correctement. Réinstallez-le et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin सही ढंग से इंस्टॉल नहीं है। इसे दोबारा इंस्टॉल करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin tidak terinstal dengan benar. Instal ulang, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin non è installato correttamente. Reinstallalo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisinが正しくインストールされていません。再インストールして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin이 올바르게 설치되지 않았습니다. 재설치한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Irisin não está instalado corretamente. Reinstale-o e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение Irisin установлено неправильно. Переустановите его и повторите попытку."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin haijasakinishwa ipasavyo. Isakinishe upya kisha ujaribu tena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin doğru yüklenmemiş. Yeniden yükleyin ve yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin chưa được cài đặt đúng cách. Hãy cài đặt lại Irisin rồi thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kò fi Irisin sórí ẹ̀rọ dáadáa. Tún fi í sórí ẹ̀rọ kí o sì gbìyànjú lẹ́ẹ̀kansí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin 未正确安装。请重新安装后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin 未正確安裝。請重新安裝後再試一次。"
          }
        }
      }
    },
