    "%@ conflicts with %@. Remove one of them and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعارض %1$@ مع %2$@. أزِل إحداهما وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ steht im Konflikt mit %2$@. Entferne eines der beiden Pakete und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ conflicts with %2$@. Remove one of them and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entra en conflicto con %2$@. Quita uno de los dos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est en conflit avec %2$@. Retirez l’un des deux et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è in conflitto con %2$@. Rimuovine uno e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ と %2$@ が競合しています。どちらかを削除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 패키지가 %2$@ 패키지와 충돌합니다. 둘 중 하나를 제거한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
