          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未完成安装。请先重新安装它，再进行其他更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未完成安裝。請先重新安裝，再進行其他變更。"
          }
        }
      }
