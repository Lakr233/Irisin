#include "Version.xcconfig"

// Single source of truth for the minimum OS across every product target.
// `make check` fails if this lands in project.pbxproj instead: a target-level
// IPHONEOS_DEPLOYMENT_TARGET silently shadows this file.
//
// Whatever number is here is a promise the SDK will try to break for you: the
// linker believes the SDK's availability metadata, and where that is wrong
// the app dies in dyld before `main` on the old device. See AGENTS.md.
IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Copied property lists stay as written: the recommended repository lists
// (Resources/Environments) are XML with comments, and
// default-list-managed.plist is a file the jailbreak and people edit on the
// device. Info.plist has its own INFOPLIST_OUTPUT_FORMAT.
PLIST_FILE_OUTPUT_FORMAT = same-as-input

// `#file` in Swift 5 mode is the absolute path of the source, so every
// `fatalError` and `precondition` would otherwise ship the build machine's
// home directory; SE-0274 makes it `Module/File.swift` instead. The prefix
// maps cover debug info and C's `__FILE__`. Scripts/package-deb.sh fails on
// a path that slipped through anyway.
SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE = YES
OTHER_SWIFT_FLAGS = $(inherited) -file-prefix-map $(SRCROOT)=. -file-prefix-map $(OBJROOT)/../..=DerivedData
OTHER_CFLAGS = $(inherited) -ffile-prefix-map=$(SRCROOT)=. -ffile-prefix-map=$(OBJROOT)/../..=DerivedData

// Optional DEVELOPMENT_TEAM / CODE_SIGN_STYLE live in the git-ignored
// Developer*.xcconfig overlays. See Developer.xcconfig.example.
//
// Device packages from `make deb` override signing on the xcodebuild command
// line; Scripts/package-deb.sh ad-hoc signs with ldid.
