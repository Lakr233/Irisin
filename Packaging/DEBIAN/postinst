#!/bin/sh
# Scripts/package-deb.sh substitutes the install prefix below: empty for
# roothide (whose dpkg relocates rootful paths into the randomized bootstrap
# root) and /var/jb for rootless.

# The app runs as mobile and keeps its state here. Some bootstraps leave
# Documents owned by root, where mobile cannot make the directory itself and
# the app stops at launch (issue 124). The path is the same on both flavors:
# roothide's sh reads it inside the bootstrap, as the app does.
data=/var/mobile/Documents/wiki.qaq.irisin
mkdir -p "$data" && chown 501:501 "$data" || {
    echo "warning: $data could not be prepared for Irisin." >&2
}

helper=@PREFIX@/usr/libexec/irisin-install
if [ -x "$helper" ]; then
    echo '{"bootstrapIrisinDaemon":{}}' | "$helper" >/dev/null || {
        echo "warning: Irisin's background service could not be loaded and started." >&2
        echo "warning: reinstall Irisin before trying to install packages." >&2
    }
fi

# The helper registers every new or moved bundle in the bootstrap's
# /Applications with LaunchServices: the same job the app's Rebuild Icons
# sends, handed over on standard input. It finds the bootstrap root from its
# own path, so no rootful path is spelled here: on roothide that path must
# stay unspoken. Its transcript is JSON for the app and is also in its log.
if [ -x "$helper" ]; then
    echo '{"rebuildIconCache":{}}' | "$helper" >/dev/null || {
        echo "warning: irisin.app was not registered with LaunchServices." >&2
        echo "warning: run 'uicache -a' yourself, or the Irisin icon will not appear." >&2
    }
fi

exit 0
