<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The helper's entitlements: the daemon's (run as root, outside the sandbox,
	touch app bundles), plus what icli is signed with for the work the helper
	now does through IcliKit in its own process: LaunchServices registration,
	MobileInstallation and container lookups behind it, and FrontBoard's
	relaunch action for the respring. The daemon gets none of these.
	Scripts/package-deb.sh reads them back out of the signed binary.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Browse</string>
		<string>Lookup</string>
		<string>Install</string>
		<string>Uninstall</string>
		<string>InstallForLaunchServices</string>
		<string>UninstallForLaunchServices</string>
		<string>CopyInstalledAppsForLaunchServices</string>
	</array>
	<key>com.apple.private.coreservices.canmaplsdatabase</key>
	<true/>
	<key>com.apple.lsapplicationworkspace.rebuildappdatabases</key>
	<true/>
	<key>com.apple.private.coreservices.can-perform-rebuild-registration</key>
	<true/>
	<key>com.apple.private.coreservices.lsaw</key>
	<true/>
	<key>com.apple.private.coreservices.can-register-install-results</key>
	<true/>
	<key>com.apple.private.coreservices.can-send-install-notifications</key>
	<true/>
	<key>com.apple.private.coreservices.canforcedatabasegc</key>
	<true/>
	<key>com.apple.private.coreservices.canmapbundleidtouuid</key>
	<true/>
	<key>com.apple.private.installcoordinationd.daemon</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.delete</key>
	<true/>
	<key>com.apple.private.security.container-manager</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<key>com.apple.frontboard.shutdown</key>
	<true/>
</dict>
</plist>
