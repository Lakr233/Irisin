<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The helper's entitlements: the daemon's (run as root, outside the sandbox,
	touch app bundles), plus what icli is signed with for the work the helper
	now does through IcliKit in its own process: LaunchServices registration,
	MobileInstallation and container lookups behind it, and FrontBoard's
	relaunch action for the respring. The daemon gets none of these.
	Scripts/package-deb.sh reads them back out of the signed binary.

	The `com.apple.private.security.storage.<Class>` keys are data-vault
	storage classes: a directory the kernel refuses with EPERM to every
	process without its class, root and `no-sandbox` included. A package
	that places a file under one (`/var/mobile/Library/Preferences`,
	`/var/Keychains`, ...) fails there without it. The list is Fila's
	(`Filad.entitlements`): every class named in the iOS 18.6 and iOS 27.0
	runtime roots, plus the older ones the rootless bootstrap's own tools
	carry. A class the running OS does not know is ignored.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
